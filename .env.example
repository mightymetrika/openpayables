# Development database ONLY. Do not point this at blindstats or randomplayables.
OPENPAYABLES_DATABASE_URL=postgresql://openpayables:openpayables_local_only@127.0.0.1:55432/openpayables
OPENPAYABLES_OPERATOR_ID=local-operator

# Optional: small serverless application instances should set 1 (default 5, maximum 20).
# OPENPAYABLES_POOL_MAX=1
# Optional Supabase operator-owned hosting: see docs/SUPABASE_POSTGRES_DEPLOYMENT.md.
# Keep all remote database URLs, passwords and CA files out of Git.

# Only for explicitly enabled PostgreSQL integration tests, never Production.
# OPENPAYABLES_TEST_DATABASE_URL=postgresql://openpayables:openpayables_local_only@127.0.0.1:55432/openpayables

# Stripe TEST mode only. Never paste keys into Git or into chat.
# OPENPAYABLES_STRIPE_TEST_SECRET_KEY=sk_test_...
# OPENPAYABLES_STRIPE_TEST_WEBHOOK_SECRET=whsec_...
# OPENPAYABLES_WEBHOOK_PORT=8787

# Optional GitHub App installation (C9). Only the App host stores its RSA private key.
# OPENPAYABLES_GITHUB_APP_ID=123456
# OPENPAYABLES_GITHUB_APP_PRIVATE_KEY_PATH=C:\secure\private-github-app-key.pem
# Keep .pem outside this repository, never commit keys or installation tokens.

# Contributor-controlled authorization (C10): public GitHub App Client ID, not App ID.
# Enable Device Flow in the same GitHub App settings; never store OAuth tokens.
# OPENPAYABLES_GITHUB_APP_CLIENT_ID=Iv23YOUR_PUBLIC_CLIENT_ID

# Separate LIVE read-only readiness probe (no DB, writes, or money movement).
# Create a restricted rk_live_ key with read-only account/balance access.
# Do not store the actual key in .env, Git, or source.
# OPENPAYABLES_STRIPE_LIVE_READ_KEY=rk_live_...
# OPENPAYABLES_LIVE_EXPECTED_PLATFORM_ACCOUNT_ID=acct_...
# OPENPAYABLES_LIVE_READ_ONLY_CONFIRM=YES_READ_ONLY
